    <general class="torque" name="RL_hip" joint="RL_hip_joint"/>
    <general class="torque" name="RL_thigh" joint="RL_thigh_joint"/>
    <general class="torque" name="RL_calf" joint="RL_calf_joint"/>
  </actuator> -->

  <!-- <include file="assets/fractal.xml" /> -->

  <sensor>
    <!-- <user name="Fly-high" dim="12" user="9 0.5 0.0 1.0 90. 1. 1." /> -->
    <user name="Fly-high" dim="12" user="9 0.01 0.0 1.0 90. 0.5 1." />
    <user name="Body Pos." dim="3" user="0 0. 0.0 100.0" />
    <user name="Body Rot." dim="9" user="0 3. 0.0 10.0" />
    <user name="Body Vel" dim="3" user="0 2. 0. 1.0 90." />
    <user name="Body Ang vel" dim="3" user="0 2. 0.0 1.0 90." />
    <user name="Air-time-cost" dim="4" user="5 2000 0.0 1.0 4" />
    <!-- <user name="Forces" dim="12" user="0 0.0 0.0 1.0" /> -->
    <user name="Foot-Vel" dim="12" user="0 0. 0.0 1.0" />
    <user name="Control" dim="12" user="0 0.2 0.0 1.0" />
    <!-- <user name="Body Rot.Vel" dim="3" user="0 0.5 0.0 100.0" /> -->
    <!-- <user name="Body Acc" dim="3" user="0 0. 0.0 1.0 90." /> -->

    <!-- <framepos      name="trace0" objtype="body" objname="trunk"/> -->
    <framepos      name="position" objtype="body" objname="trunk"/>
    <framequat     name="orientation" objtype="xbody" objname="trunk"/>
    <!-- <subtreecom    name="torso_subtreecom" body="trunk"/> -->
    <!-- <subtreelinvel name="torso_subtreelinvel" body="trunk"/> -->
    <!-- <framezaxis    name="torso_zaxis" objtype="xbody" objname="trunk"/> -->


    <framelinvel   name="FR_vel" objtype="site" objname="FR" reftype="world" refname="world"/>
    <framelinvel   name="FL_vel" objtype="site" objname="FL" reftype="world" refname="world"/>
    <framelinvel   name="HR_vel" objtype="site" objname="RR" reftype="world" refname="world"/>
    <framelinvel   name="HL_vel" objtype="site" objname="RL" reftype="world" refname="world"/>

    <framelinacc   name="FR_acc" objtype="site" objname="FR"/>
    <framelinacc   name="FL_acc" objtype="site" objname="FL"/>
    <framelinacc   name="HR_acc" objtype="site" objname="RR"/>
    <framelinacc   name="HL_acc" objtype="site" objname="RL"/>

    <framepos      name="FR" objtype="site" objname="FR" reftype="world" refname="world"/>
    <framepos      name="FL" objtype="site" objname="FL" reftype="world" refname="world"/>
    <framepos      name="HR" objtype="site" objname="RR" reftype="world" refname="world"/>
    <framepos      name="HL" objtype="site" objname="RL" reftype="world" refname="world"/>
    
    <touch         name="FR_touch" site="FR"/>
    <touch         name="FL_touch" site="FL"/>
    <touch         name="HR_touch" site="RR"/>
    <touch         name="HL_touch" site="RL"/>

    <force         name="FR_force" site="FR"/>
    <force         name="FL_force" site="FL"/>
    <force         name="HR_force" site="RR"/>
    <force         name="HL_force" site="RL"/>

    <framelinvel   name="velocity_trunk" objtype="body" objname="trunk" reftype="world" refname="world"/>
    <frameangvel   name="ang_velocity_trunk" objtype="body" objname="trunk" reftype="world" refname="world"/>
    <framelinacc   name="acc_lin_trunk" objtype="body" objname="trunk"/>


  </sensor>

